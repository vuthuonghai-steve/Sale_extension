{
  "quality-gates": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_placeholder_pre.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_contract_lock.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_viability.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_arch_boundary.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_test_in_src.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/pre_tool_use/gate_test_bypass.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/scripts/stop/gate_placeholder_stop.py",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "python3 hooks/scripts/stop/gate_stop_verify.py",
        "timeout": 60
      },
      {
        "type": "command",
        "command": "python3 hooks/scripts/stop/gate_doc_structure.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "python3 hooks/scripts/stop/gate_evidence.py",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/scripts/pre_invocation/remind_domain_anchor.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/post_tool_use/gate_traceid.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/post_tool_use/gate_secret_scan.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
