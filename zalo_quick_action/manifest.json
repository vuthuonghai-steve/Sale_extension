{
  "manifest_version": 3,
  "name": "Zalo Quick Forward & Selection Action",
  "version": "1.0.0",
  "description": "Tiện ích hỗ trợ thao tác nhanh, bán tự động chuyển tiếp tin nhắn Zalo Web & xử lý bôi đen văn bản.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "management"
  ],
  "host_permissions": [
    "https://chat.zalo.me/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "quick-share-zalo": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Chuyển tiếp nhanh văn bản bôi đen (Alt+S)"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.zalo.me/*",
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content/content-logger.js",
        "content/content-config.js",
        "content/content-text.js",
        "content/content-ui.js",
        "content/content-zalo-adapter.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
