{
  "remind-domain-anchor": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./hooks/scripts/pre_invocation/remind_domain_anchor.py",
        "timeout": 15
      }
    ]
  },
  "gate-pre-tool-checks": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/scripts/pre_tool_use/gate_placeholder_pre.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python ./hooks/scripts/pre_tool_use/gate_contract_lock.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python ./hooks/scripts/pre_tool_use/gate_screen_limit.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python ./hooks/scripts/pre_tool_use/gate_arch_boundary.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "gate-stop-verify": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/scripts/stop/gate_stop_verify.py",
        "timeout": 60
      }
    ]
  }
}