using System;
using System.Drawing;
using System.Windows.Forms;
using AppForms.Shared.Constants;
using AppForms.Frontend.Screens.{{ScreenName}}.Models;

namespace AppForms.Frontend.Screens.{{ScreenName}}.Components
{
    /// <summary>
    /// Sub-Component for {{ScreenName}} editing / input.
    /// Pure View component communicating via BindData, GetFormData, and Events.
    /// </summary>
    public class {{ScreenName}}EditorPanel : Panel
    {
        private TextBox _titleInput = null!;
        private TextBox _contentInput = null!;
        private Button _submitButton = null!;

        public event Action<{{ScreenName}}FormModel>? ActionTriggered;

        public {{ScreenName}}EditorPanel()
        {
            InitializeComponent();
        }

        private void InitializeComponent()
        {
            BackColor = AppColors.Surface;
            Padding = new Padding(16);
            BorderStyle = BorderStyle.None;

            var titleLabel = new Label
            {
                Text = "Tiêu đề:",
                Font = AppFonts.Header,
                ForeColor = AppColors.TextPrimary,
                AutoSize = true,
                Location = new Point(16, 16)
            };

            _titleInput = new TextBox
            {
                Font = AppFonts.Regular,
                ForeColor = AppColors.TextPrimary,
                BackColor = AppColors.SurfaceLight,
                Location = new Point(16, 44),
                Width = 320
            };

            var contentLabel = new Label
            {
                Text = "Nội dung:",
                Font = AppFonts.Header,
                ForeColor = AppColors.TextPrimary,
                AutoSize = true,
                Location = new Point(16, 84)
            };

            _contentInput = new TextBox
            {
                Font = AppFonts.Regular,
                ForeColor = AppColors.TextPrimary,
                BackColor = AppColors.SurfaceLight,
                Multiline = true,
                ScrollBars = ScrollBars.Vertical,
                Location = new Point(16, 112),
                Size = new Size(320, 140)
            };

            _submitButton = new Button
            {
                Text = "Thực hiện",
                Font = AppFonts.Header,
                ForeColor = Color.White,
                BackColor = AppColors.Primary,
                FlatStyle = FlatStyle.Flat,
                Location = new Point(16, 268),
                Size = new Size(120, 36)
            };
            _submitButton.FlatAppearance.BorderSize = 0;
            _submitButton.Click += OnSubmitButtonClicked;

            Controls.Add(titleLabel);
            Controls.Add(_titleInput);
            Controls.Add(contentLabel);
            Controls.Add(_contentInput);
            Controls.Add(_submitButton);
        }

        private void OnSubmitButtonClicked(object? sender, EventArgs e)
        {
            var model = GetFormData();
            ActionTriggered?.Invoke(model);
        }

        public void BindData({{ScreenName}}FormModel model)
        {
            _titleInput.Text = model.Title;
            _contentInput.Text = model.Content;
        }

        public {{ScreenName}}FormModel GetFormData()
        {
            return new {{ScreenName}}FormModel
            {
                Title = _titleInput.Text.Trim(),
                Content = _contentInput.Text.Trim()
            };
        }
    }

    /// <summary>
    /// Sub-Component for {{ScreenName}} preview box.
    /// </summary>
    public class {{ScreenName}}PreviewBox : Panel
    {
        private TextBox _previewOutput = null!;

        public {{ScreenName}}PreviewBox()
        {
            InitializeComponent();
        }

        private void InitializeComponent()
        {
            BackColor = AppColors.Surface;
            Padding = new Padding(16);

            var previewLabel = new Label
            {
                Text = "Xem trước kết quả:",
                Font = AppFonts.Header,
                ForeColor = AppColors.TextPrimary,
                AutoSize = true,
                Location = new Point(16, 16)
            };

            _previewOutput = new TextBox
            {
                Font = AppFonts.Regular,
                ForeColor = AppColors.TextPrimary,
                BackColor = AppColors.SurfaceLight,
                Multiline = true,
                ReadOnly = true,
                ScrollBars = ScrollBars.Vertical,
                Location = new Point(16, 44),
                Size = new Size(340, 260)
            };

            Controls.Add(previewLabel);
            Controls.Add(_previewOutput);
        }

        public void BindData({{ScreenName}}FormModel model)
        {
            _previewOutput.Text = $"[Tiêu đề]: {model.Title}\r\n[Cập nhật]: {model.LastModifiedUtc:HH:mm:ss}\r\n\r\n{model.Content}";
        }
    }
}
